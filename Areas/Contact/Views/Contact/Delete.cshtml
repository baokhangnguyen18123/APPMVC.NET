@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model App.Models.Contacts.Contact

@{
    ViewData["Title"] = "Xóa liên hệ";
}

<section class="contact-page contact-page--admin">
<div class="contact-page__header">
    <h1>@ViewData["Title"]</h1>
</div>

<h2 class="contact-record__warning">Bạn có chắc muốn xóa liên hệ này không ?</h2>
<div class="contact-record">
    <dl class="row contact-record__body">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FullName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FullName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DateSent)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DateSent)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Phone)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Phone)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Message)
        </dt>
        <dd class="col-sm-10 contact-record__message">
            @Html.DisplayFor(model => model.Message)
        </dd>
    </dl>

    <form asp-action="Delete" class="contact-page__actions">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Xóa" class="contact-button contact-button--danger" />
        <a class="contact-button" asp-action="Index">Danh sách liên hệ</a>
    </form>
</div>
</section>
