@model App.Models.Contacts.Contact

@{
    ViewData["Title"] = "Gửi liên hệ đến AppMVC";
}

<section class="contact-page contact-page--send">
    <div class="row justify-content-center align-items-center g-5">

        <div class="col-lg-5 contact-page__intro text-center text-lg-start">
            <h1>@ViewData["Title"]</h1>
            <p class="contact-page__lead">
                Chúng tôi luôn mong muốn lắng nghe ý kiến từ bạn. Hãy để lại thông tin và tin nhắn, chúng tôi sẽ phản
                hồi trong thời gian sớm nhất!
            </p>
            <hr class="contact-page__accent mx-auto mx-lg-0">
        </div>

        <div class="col-lg-7 col-xl-6">
            <div class="contact-card">
                <div class="contact-card__body">
                    <form asp-action="SendContact" class="contact-form">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger contact-form__summary"
                             role="alert"></div>

                        <div class="form-floating">
                            <input asp-for="FullName" class="form-control contact-form__control"
                                   placeholder="Họ và tên" />
                            <label asp-for="FullName"></label>
                            <span asp-validation-for="FullName"
                                  class="contact-form__validation"></span>
                        </div>

                        <div class="form-floating">
                            <input asp-for="Email" class="form-control contact-form__control"
                                   placeholder="name@example.com" />
                            <label asp-for="Email"></label>
                            <span asp-validation-for="Email" class="contact-form__validation"></span>
                        </div>



                        <div class="form-floating">
                            <input asp-for="Phone" class="form-control contact-form__control"
                                   placeholder="Số điện thoại" />
                            <label asp-for="Phone"></label>
                            <span asp-validation-for="Phone" class="contact-form__validation"></span>
                        </div>


                        <div class="form-floating">
                            <textarea asp-for="Message"
                                      class="form-control contact-form__control contact-form__message"
                                      placeholder="Nội dung tin nhắn"></textarea>
                            <label asp-for="Message"></label>
                            <span asp-validation-for="Message" class="contact-form__validation"></span>
                        </div>

                        <div class="contact-form__actions">
                            <button type="submit" class="btn contact-form__submit">
                                <span>Gửi liên hệ ngay</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
                                     class="bi bi-send-fill" viewBox="0 0 16 16">
                                    <path
                                    d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083zm-1.833 1.89L6.637 10.07l-.215-.338a.5.5 0 0 0-.154-.154l-.338-.215 7.494-7.494 1.178-.471z" />
                                </svg>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</section>