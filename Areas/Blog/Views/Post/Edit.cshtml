@model AppMvc.Areas.Blog.Models.CreatePostModel;

@{
    ViewData["Title"] = "Sửa bài viết";
    var list = ViewData["CategoryIds"] as MultiSelectList;
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="mb-4">
            <div class="text-primary fw-semibold text-uppercase small mb-1">Quản lý bài viết</div>
            <h1 class="h2 mb-2">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Cập nhật nội dung và kiểm tra thiết lập trước khi lưu thay đổi.</p>
        </div>

        <form asp-action="Edit" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>
            }
            <input type="hidden" asp-for="@Model.PostId" />

            <div class="card border rounded-4 shadow-sm overflow-hidden">
                <div class="card-body p-3 p-md-4 p-lg-5">
                    <div class="border-bottom mb-4 pb-3">
                        <h2 class="h5 mb-1">Nội dung bài viết</h2>
                        <p class="text-muted small mb-0">Chỉnh sửa tiêu đề, phần giới thiệu và nội dung chính.</p>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="Nhập tiêu đề bài viết" />
                        <div class="form-text">Một tiêu đề ngắn gọn sẽ giúp người đọc nhanh chóng hiểu chủ đề.</div>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Tóm tắt nội dung nổi bật của bài viết"></textarea>
                        <div class="form-text">Phần này có thể được dùng làm nội dung giới thiệu trong danh sách bài viết.</div>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div>
                        <label asp-for="Content" class="form-label fw-semibold"></label>
                        <textarea asp-for="Content" class="form-control" rows="14" placeholder="Bắt đầu viết nội dung..."></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>

                    <div class="border-top mt-5 pt-4">
                        <div class="mb-4">
                            <h2 class="h5 mb-1">Thiết lập bài viết</h2>
                            <p class="text-muted small mb-0">Chọn chuyên mục, đường dẫn và trạng thái hiển thị.</p>
                        </div>

                        <div class="row g-4">
                            <div class="col-lg-6">
                                <label asp-for="@Model.CategoryIDs" class="form-label fw-semibold"></label>
                                <select asp-for="@Model.CategoryIDs" multiple="multiple" class="w-100" asp-items="list"></select>
                                <div class="form-text">Có thể chọn nhiều chuyên mục phù hợp với bài viết.</div>
                                <span asp-validation-for="@Model.CategoryIDs" class="text-danger small"></span>
                            </div>

                            <div class="col-lg-6">
                                <label asp-for="Slug" class="form-label fw-semibold"></label>
                                <input asp-for="Slug" class="form-control" placeholder="de-trong-de-tu-dong-tao" />
                                <div class="form-text">Để trống để tự tạo từ tiêu đề, hoặc chỉ dùng chữ thường, số và dấu gạch ngang.</div>
                                <span asp-validation-for="Slug" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="rounded-3 border bg-body-tertiary p-3">
                                    <div class="form-check form-switch mb-1">
                                        <input class="form-check-input" asp-for="Published" role="switch" />
                                        <label asp-for="Published" class="form-check-label fw-semibold"></label>
                                    </div>
                                    <div class="text-muted small">Bật tùy chọn này để bài viết hiển thị với người đọc sau khi lưu.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-body-tertiary border-top p-3 p-md-4">
                    <div class="d-flex flex-column-reverse flex-sm-row justify-content-sm-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại danh sách</a>
                        <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="~/lib/multiple-select/dist/multiple-select.min.css" />

    <script src="~/lib/multiple-select/dist/multiple-select.min.js"></script>

    <script>
        $("#CategoryIDs").multipleSelect({
            selectAll: false,
            keepOpen: false,
            isOpen: false,
        });
    </script>

}
@{
    var summernote = new App.Models.Summernote("#Content")
    {
        Height = 400
    };
}
<partial name="_Summernote" model="summernote" />
